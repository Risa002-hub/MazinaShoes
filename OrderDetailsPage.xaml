<Page x:Class="MazinaShoes.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MazinaShoes"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Состав заказа">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="10">
            <TextBlock x:Name="TBHeader" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="TBClient" FontSize="16"/>
            <!-- менять дату и удалять позиции может только администратор -->
            <StackPanel x:Name="PanelDate" Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Дата заказа:" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="DPDate" FontSize="16" Width="150"/>
                <Button x:Name="BtnSaveDate" Content="Сохранить дату" Width="180" Height="32" FontSize="16" Click="BtnSaveDate_Click"/>
            </StackPanel>
        </StackPanel>

        <ListView x:Name="ItemsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProductText}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock FontSize="14">
                                <Run Text="Размер: "/>
                                <Run Text="{Binding Size.SizeValue, Mode=OneWay, StringFormat=0.#}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="16" VerticalAlignment="Center" TextAlignment="Right">
                            <Run Text="{Binding Count, Mode=OneWay}"/>
                            <Run Text=" пар."/>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding PriceOneItem, StringFormat={}{0:N2} руб.}" FontSize="16"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding LineSum, StringFormat={}{0:N2} руб.}" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <DockPanel Grid.Row="2" Margin="10">
            <TextBlock x:Name="TBTotal" DockPanel.Dock="Left" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="BtnDeleteItem" Content="Удалить позицию" Width="220" HorizontalAlignment="Right" Click="BtnDeleteItem_Click"/>
        </DockPanel>
    </Grid>
</Page>
