<Page x:Class="MazinaShoes.AutorisationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MazinaShoes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AutorisationPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Введите Логин" FontSize="30" Margin="5" Height="70" Grid.Column="1" HorizontalAlignment="Center"/>
        <TextBlock Text="Логин:"  FontSize="30" Margin="5" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LogTB" Margin="5" Width="300" Height="70" FontSize="20"/>
        <Button Content="Войти" Name="LogBtn"  Click="LogBtn_Click"  Grid.Column="1" Grid.Row="2" Height="70" Width="300"/>
        <Button Content="Войти как гость" Name="QuestBtn" Click="QuestBtn_Click" Grid.Column="1" Grid.Row="3" Height="50" Width="300"/>
    </Grid>
</Page>
