<Page x:Class="MazinaShoes.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MazinaShoes"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Просмотр товара">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Height="250" Stretch="Uniform" VerticalAlignment="Top"
                   Source="{Binding FullPath, TargetNullValue='/img/picture.png', FallbackValue='/img/picture.png'}"/>

            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                <TextBlock Text="{Binding ProductName}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock FontSize="16" TextWrapping="Wrap">
                    <Run Text="Категория: "/>
                    <Run Text="{Binding Subcategory.Category.CategoryName, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding Subcategory.SubcategoryName, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="16" TextWrapping="Wrap">
                    <Run Text="Производство: "/>
                    <Run Text="{Binding Manufacturer.ManufacturerName, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Цена: " FontSize="20"/>
                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} руб.}" FontSize="20"
                               TextDecorations="Strikethrough" Margin="0,0,10,0"
                               Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding PriceWithDiscount, StringFormat={}{0:N2} руб.}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock FontSize="16" TextWrapping="Wrap">
                    <Run Text="Состав: "/>
                    <Run Text="{Binding Ingredients, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="16" TextWrapping="Wrap">
                    <Run Text="Описание: "/>
                    <Run Text="{Binding Description, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock x:Name="TBSizes" FontSize="16" TextWrapping="Wrap" Margin="0,5,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="Размер:" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="ComboSize" DisplayMemberPath="Caption" FontSize="16" Width="200"/>
                    <TextBlock Text="Пар:" FontSize="16" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBox x:Name="TBCount" Text="1" FontSize="16" Width="60" VerticalContentAlignment="Center"
                             PreviewTextInput="TBCount_PreviewTextInput"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnAdd" Content="Добавить в заказ" Width="200" Click="BtnAdd_Click"/>
                    <Button Content="Отказаться" Background="#D2F6E7" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
