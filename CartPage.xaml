<Page x:Class="MazinaShoes.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MazinaShoes"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Оформление заказа">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- клиента выбирает только менеджер или администратор -->
        <StackPanel x:Name="PanelClient" Orientation="Horizontal" Margin="10" Background="#D2F6E7">
            <TextBlock Text="Клиент:" FontSize="16" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="ComboClient" DisplayMemberPath="FullName" FontSize="16" Width="300"/>
        </StackPanel>

        <ListView x:Name="CartList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding ProductText}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock FontSize="14">
                                <Run Text="Размер: "/>
                                <Run Text="{Binding Stock.Size.SizeValue, Mode=OneWay, StringFormat=0.#}"/>
                                <Run Text="   Цена: "/>
                                <Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N2} руб.}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="−" Width="35" Height="30" FontSize="16" Click="BtnMinus_Click"/>
                            <TextBlock Text="{Binding Count}" FontSize="18" VerticalAlignment="Center" Width="30" TextAlignment="Center"/>
                            <Button Content="+" Width="35" Height="30" FontSize="16" Click="BtnPlus_Click"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Sum, StringFormat={}{0:N2} руб.}" FontSize="18"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Button Grid.Column="3" Content="Удалить" Width="90" Height="30" FontSize="14" Background="#D2F6E7" Click="BtnRemove_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <DockPanel Grid.Row="2" Margin="10">
            <TextBlock x:Name="TBTotal" DockPanel.Dock="Left" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Подтвердить заказ" Width="220" Click="BtnConfirm_Click"/>
                <Button Content="Отказаться от заказа" Width="240" Background="#D2F6E7" Click="BtnCancelOrder_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Page>
