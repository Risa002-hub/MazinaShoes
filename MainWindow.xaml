<Window x:Class="MazinaShoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MazinaShoes"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="/img/Чудо Обувь.ico" FontFamily="Calibri"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Image Source="/img/Чудо Обувь.png" Grid.Row="0" HorizontalAlignment="Left"/>
        <TextBlock Text="Чудо обувь" FontSize="30" Margin="5" HorizontalAlignment="Center"/>
        <Frame Grid.Row="1" Background="#D2F6E7" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden" ></Frame>
        <Button Content="Back" Name="BtnBack"  HorizontalAlignment="Right"  Click="BtnBack_Click"></Button>
    </Grid>
</Window>
