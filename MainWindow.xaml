<Window x:Class="MazinaShoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MazinaShoes"
        mc:Ignorable="d"
        Title="Чудо Обувь" Height="650" Width="950" MinHeight="450" MinWidth="700"
        Icon="/img/Чудо Обувь.ico" FontFamily="Calibri" Background="#FFFFFF"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="#D2F6E7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="/img/Чудо Обувь.png" Height="50" Margin="5"/>
                <Button Content="Назад" Name="BtnBack" Width="100" Height="35" FontSize="16" Click="BtnBack_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Чудо обувь" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Name="TBPageTitle" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
            <TextBlock Name="TBUser" Grid.Column="2" FontSize="16" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <Frame Grid.Row="1" Background="#FFFFFF" Name="MainFrame" NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated" ContentRendered="MainFrame_ContentRendered"/>
    </Grid>
</Window>
