<Page x:Class="MazinaShoes.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MazinaShoes"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Вход в систему">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Вход в систему" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Логин" FontSize="18"/>
        <TextBox x:Name="TBLogin" FontSize="18" Width="280" Margin="0,5,0,15"/>
        <Button Content="Войти" IsDefault="True" Width="280" Click="BtnLogin_Click"/>
        <Button Content="Войти как гость" Width="280" Background="#D2F6E7" Click="BtnGuest_Click"/>
    </StackPanel>
</Page>
