<Page x:Class="MazinaShoes.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MazinaShoes"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Аналитика">

    <StackPanel Margin="15">
        <StackPanel Orientation="Horizontal" Background="#D2F6E7">
            <TextBlock Text="С:" FontSize="16" VerticalAlignment="Center" Margin="5"/>
            <DatePicker x:Name="DPStart" FontSize="16" Width="150" SelectedDateChanged="Period_Changed"/>
            <TextBlock Text="по:" FontSize="16" VerticalAlignment="Center" Margin="15,5,5,5"/>
            <DatePicker x:Name="DPEnd" FontSize="16" Width="150" SelectedDateChanged="Period_Changed"/>
            <Button Content="Экспорт в PDF" Width="180" Height="32" FontSize="16" Margin="20,5,5,5" Click="BtnExport_Click"/>
        </StackPanel>

        <TextBlock x:Name="TBOrders" FontSize="20" Margin="0,15,0,0"/>
        <TextBlock x:Name="TBSum" FontSize="20"/>

        <TextBlock Text="Топ-5 моделей по количеству проданных пар" FontSize="18" FontWeight="Bold" Margin="0,15,0,5"/>
        <DataGrid x:Name="GridTop" AutoGenerateColumns="False" IsReadOnly="True" FontSize="16"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Модель" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Производство" Binding="{Binding Manufacturer}" Width="200"/>
                <DataGridTextColumn Header="Пар" Binding="{Binding Count}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Page>
