<Page x:Class="MazinaShoes.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MazinaShoes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock Text="Поиск товара:" TextAlignment="Right" Width="150" FontSize="18"/>
                <TextBox x:Name="TBSearch" TextChanged="TBSearch_TextChanged" FontSize="15" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="По Категории:" TextAlignment="Right" Width="150" FontSize="18"/>
                <ComboBox Name="ComboCategory" SelectionChanged="ComboCategory_SelectionChanged" FontSize="15" Width="200"   SelectedValuePath="Content">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Женская обувь"/>
                    <ComboBoxItem Content="Мужская обувь"/>
                    <ComboBoxItem Content="Детская обувь"/>
                </ComboBox>
            </StackPanel>
        </WrapPanel>
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5">
            <RadioButton Content="Сначала дороже" GroupName="Sort" Width="200" FontSize="18" Checked="RButtonUp_Checked" Name="RButtonUp"/>
            <RadioButton Content="Сначала дешевле" GroupName="Sort" Width="200" FontSize="18" Checked="RButtonDown_Checked" Name="RButtonDown"/>
        </StackPanel>

        <ListView x:Name="ProductPageListView" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Image Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="{Binding FullPath, TargetNullValue='/img/picture.png', FallbackValue='/img/picture.png'}" />


                        <TextBlock Grid.Column="1" Grid.Row="0" FontSize="16" TextWrapping="Wrap">
                            <!-- тут будут данные (придумать)-->
                            <TextBlock Text="ID: "/>
                             <TextBlock Text="{Binding ProductID}"/>
                             <TextBlock Text="  "/>
                             <TextBlock Text="{Binding ProductName}"/>
                             <TextBlock Text="  "/> 
                        </TextBlock>
                        <TextBlock Grid.Column="1" Grid.Row="1" FontSize="16" TextWrapping="Wrap">
                            <TextBlock Text="Бренд: "/>
                            <TextBlock Text="{Binding Manufacturer.ManufacturerName}"/>
                            <TextBlock Text="  Подкатегория: "/>
                            <TextBlock Text="{Binding Subcategory.SubcategoryName}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Grid.Row="2" FontSize="18" TextWrapping="Wrap">
                            <TextBlock Text="Цена: "/>
                            <TextBlock Text="{Binding Price}"/>
                            <TextBlock Text=" рублей"/>
                        </TextBlock>
                        











                    </Grid>
                    
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
